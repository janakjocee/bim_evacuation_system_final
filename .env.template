# BIM Evacuation System Configuration
# Copy this file to .env and fill in your values

# Application Settings
APP_NAME=BIM_Evacuation_Scenario_Generator
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Paths
DATA_DIR=./data
OUTPUT_DIR=./data/outputs
IFC_DIR=./data/sample_ifc
REGULATION_DIR=./data/regulations

# NLP and RAG Settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.7

# Regulation Processing
REGULATION_FILE=./data/regulations/approved_document_b.txt

# Scenario Generation
MAX_SCENARIOS=10
DEFAULT_OCCUPANCY_DENSITY=0.5
TRAVEL_SPEED=1.2
SAFETY_FACTOR=1.5

# UI Settings
STREAMLIT_PORT=8501
STREAMLIT_THEME=light

# Export Settings
DEFAULT_EXPORT_FORMAT=json
EXPORT_TIMESTAMP=true

# Evaluation
EVALUATION_METRICS=compliance,feasibility,safety,efficiency
BASELINE_COMPARISON=true
